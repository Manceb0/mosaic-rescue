# ============================================================
# DATOS DEL PACIENTE — NUNCA EN EL REPOSITORIO
# Recordatorio: .gitignore NO es un control de seguridad.
# Si algo se commiteó una vez, sigue en el historial.
# Verifica antes de cada commit (ver CLAUDE.md, Regla Dura 1).
# ============================================================

# Directorio de datos: ignorado en bloque
data/*
data_raw/
raw/
private/

# Secuenciación cruda y alineamientos
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.sam

# Variantes y derivados con genotipos
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.vcf.gz.csi
*.bcf
*.gvcf*
*.ped
*.fam
*.bim
*.plink*

# Configuración con rutas reales
config/paths.yaml
config/*.local.*
.env
*.secret
*.key
*.pem

# Directorios de trabajo y resultados
work/
results/
outputs/
tmp/
scratch/
*.log

# Índices y referencias (grandes, no versionar)
reference/
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.fai
*.dict
*.amb
*.ann
*.bwt*
*.pac
*.sa
*.0123

# Notebooks: los outputs ejecutados embeben datos del paciente
# aunque el fichero fuente esté ignorado. Ver CONTRIBUTING_RESEARCH.md
.ipynb_checkpoints/
*-checkpoint.ipynb

# Entornos y caché
__pycache__/
*.py[cod]
.venv/
venv/
env/
.snakemake/
.nextflow*
work-nf/
.Rhistory
.RData
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Sistema
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# ============================================================
# EXCEPCIONES — se versionan pese a las reglas de arriba
# ============================================================
!data/README.md
!config/paths.example.yaml
!config/panels/*.txt
!src/**
!docs/*.md
!research/**/*.md
!hypotheses/**/*.md

# ============================================================
# PROHIBICIONES FINALES — máxima prioridad, van las últimas
# a propósito: en git gana la ÚLTIMA regla que coincide, así
# que ninguna excepción de arriba puede reintroducir esto.
# ============================================================
*.docx
*.doc
*.xls
*.xlsx
**/Challenge_Clinical*
**/phenotype_raw*
**/*_identifiable*

# Bytecode de Python. Va AQUI y no arriba porque `!src/**` (excepcion amplia
# para versionar el codigo) reintroducia los .pyc: en git gana la ultima regla
# que coincide. Ese fue el motivo real de que se commitearan la primera vez.
__pycache__/
**/__pycache__/
*.py[cod]

